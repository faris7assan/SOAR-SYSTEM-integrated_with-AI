# AegisNDR — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to version control

# ─── API / Auth ───────────────────────────────────────────
JWT_SECRET_KEY=change_me_to_a_long_random_secret_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ─── Dashboard Credentials ────────────────────────────────
# These are demo defaults — CHANGE before any real deployment
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=change_me_analyst_password

# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegisndr
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change_me_db_password

# ─── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Elasticsearch ────────────────────────────────────────
ES_HOST=localhost
ES_PORT=9200

# ─── Network Capture ──────────────────────────────────────
CAPTURE_INTERFACE=eth0
MOCK_MODE=true

# ─── Threat Intel ─────────────────────────────────────────
# Optional: add your AbuseIPDB / VirusTotal API keys
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
